{
  "expo": {
    "name": "Mentra",
    "slug": "mentra",
    "scheme": "mentra",
    "version": "1.3.3",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/mentra-mark.png",
    "splash": {
      "image": "./assets/mentra-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFAF7",
      "dark": {
        "image": "./assets/mentra-mark.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F0E0C"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mentra.study"
    },
    "android": {
      "versionCode": 19,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mentra-mark.png",
        "backgroundColor": "#FBFAF7"
      },
      "package": "com.mentra.study",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      "expo-web-browser",
      "expo-font",
      "@config-plugins/react-native-blob-util",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F5FDB",
          "defaultChannel": "planner-reminders"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "80eb4fd2-c5ff-4eea-b7c7-8811107812df"
      }
    },
    "owner": "kodathegreat"
  }
}
