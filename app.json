{
  "expo": {
    "name": "Mentra",
    "slug": "mentra",
    "scheme": "mentra",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/mentra-mark.png",
    "splash": {
      "image": "./assets/mentra-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFCFE",
      "dark": {
        "image": "./assets/mentra-mark.png",
        "resizeMode": "contain",
        "backgroundColor": "#0B0D12"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mentra.study"
    },
    "android": {
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/mentra-mark.png",
        "backgroundColor": "#FBFCFE"
      },
      "package": "com.mentra.study",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      "expo-web-browser",
      "expo-font",
      "@config-plugins/react-native-blob-util",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1F5FDB",
          "defaultChannel": "planner-reminders"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "80eb4fd2-c5ff-4eea-b7c7-8811107812df"
      }
    },
    "owner": "kodathegreat"
  }
}
