# Public values are safe to include in the client. Keep your LLM key server-side.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_AI_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/mentra-ai
# Optional: keep the default unless your Supabase migration uses a different bucket name.
EXPO_PUBLIC_STUDY_MATERIALS_BUCKET=study-materials
